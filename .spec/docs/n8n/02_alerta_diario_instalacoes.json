    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nlet total = 0;\nconst resumo = items.map(inst => {\n  const hora = new Date(inst.data_instalacao).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\n  total += inst.valor_total;\n  return `⏰ ${hora} - 🛠️ Técnico: ${inst.tecnico.nome}\\n👤 Cliente: ${inst.cliente.nome} (Tel: ${inst.cliente.telefone})\\n📍 Endereço: ${inst.cliente.endereco}\\n💰 Total: R$ ${Number(inst.valor_total).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n}).join('\\n\\n-------------------\\n\\n');\n\nreturn [{\n  json: {\n    total_agendamentos: items.length,\n    data_amanha: new Date(Date.now() + 86400000).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n    mensagem: `📅 *RELATÓRIO DE INSTALAÇÕES PARA AMANHÃ*\\nTotal de visitas: ${items.length}\\n\\n${resumo}\\n\\n------------------\n    \\n\\nTotal geral: R$ ${Number(total).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`\n  }\n}];"
      },
      "name": "Formatar Resumo da Agenda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        16
      ],
      "id": "bdc75b88-d7ae-4062-8462-362ef13b3b49"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "v_agenda_pedidos",
        "limit": 100,
        "orderBy": "created_at.asc",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "agendado"
            },
            {
              "keyName": "data_instalacao",
              "condition": "gte",
              "keyValue": "={{ $now.setZone('America/Sao_Paulo').plus({ days: 1 }).startOf('day').toISO() }}"
            },
            {
              "keyName": "data_instalacao",
              "condition": "lte",
              "keyValue": "={{ $now.setZone('America/Sao_Paulo').plus({ days: 1 }).endOf('day').toISO() }}"
            }
          ]
