{
  "name": "SmartLar - 02 Alerta Diario Instalacoes",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "name": "Schedule Diario (07:00 Brasilia)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "id": "schedule-trigger-diario"
    },
    {
      "parameters": {
        "url": "=https://eyjfofrwjixirbuvvlmk.supabase.co/rest/v1/v_instalacoes?status=eq.agendado&and=(data_instalacao.gte.{{ $now.setZone('America/Sao_Paulo').plus({days:1}).startOf('day').toISO() }},data_instalacao.lt.{{ $now.setZone('America/Sao_Paulo').plus({days:1}).endOf('day').toISO() }})&order=data_instalacao.asc",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "<SERVICE_ROLE_KEY>"
            },
            {
              "name": "Authorization",
              "value": "=Bearer <SERVICE_ROLE_KEY>"
            }
          ]
        },
        "options": {}
      },
      "name": "Buscar Instalacoes de Amanha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "id": "http-fetch-instalacoes"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-items-check",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Existem Instalacoes Amanha?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300],
      "id": "if-has-installations"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nconst resumo = items.map(inst => {\n  const hora = new Date(inst.data_instalacao).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\n  return `⏰ ${hora} - 🛠️ Técnico: ${inst.tecnico_nome}\\n👤 Cliente: ${inst.cliente_nome} (Tel: ${inst.cliente_telefone})\\n📍 Endereço: ${inst.endereco}\\n💰 Total: R$ ${Number(inst.valor_total).toFixed(2)}`;\n}).join('\\n\\n-------------------\\n\\n');\n\nreturn [{\n  json: {\n    total_agendamentos: items.length,\n    data_amanha: new Date(Date.now() + 86400000).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n    mensagem: `📅 *RELATÓRIO DE INSTALAÇÕES PARA AMANHÃ*\\nTotal de visitas: ${items.length}\\n\\n${resumo}`\n  }\n}];"
      },
      "name": "Formatar Resumo da Agenda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 220],
      "id": "code-format-summary"
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    total_agendamentos: 0,\n    mensagem: 'Nenhuma instalação agendada para amanhã.'\n  }\n}];"
      },
      "name": "Log Sem Instalacoes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 400],
      "id": "code-no-installations"
    }
  ],
  "connections": {
    "Schedule Diario (07:00 Brasilia)": {
      "main": [
        [
          {
            "node": "Buscar Instalacoes de Amanha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Instalacoes de Amanha": {
      "main": [
        [
          {
            "node": "Existem Instalacoes Amanha?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Existem Instalacoes Amanha?": {
      "main": [
        [
          {
            "node": "Formatar Resumo da Agenda",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Sem Instalacoes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  }
}
