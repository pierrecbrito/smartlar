{
  "name": "SmartLar - 01 Novo Pedido",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smartlar-novo-pedido",
        "options": {}
      },
      "name": "Webhook Supabase (Insert Pedido)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "id": "webhook-insert-pedido"
    },
    {
      "parameters": {
        "url": "=https://<SEU-PROJETO>.supabase.co/rest/v1/pedidos?id=eq.{{ $json.body.record.id }}&select=id,status,valor_total,created_at,observacoes,cliente:clientes(nome,telefone,endereco),itens:itens_pedido(quantidade,preco_unitario,subtotal,produto:produtos(nome))",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "<SERVICE_ROLE_KEY>"
            },
            {
              "name": "Authorization",
              "value": "=Bearer <SERVICE_ROLE_KEY>"
            }
          ]
        },
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 1000
          }
        }
      },
      "name": "Buscar Pedido Completo (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "id": "http-fetch-pedido"
    },
    {
      "parameters": {
        "jsCode": "const pedido = $input.first().json;\nconst cliente = pedido.cliente || {};\nconst itens = pedido.itens || [];\n\nconst resumoItens = itens.map(i => `${i.quantidade}x ${i.produto?.nome || 'Produto'} (R$ ${Number(i.subtotal).toFixed(2)})`).join('\\n');\n\nreturn [{\n  json: {\n    pedido_id: pedido.id,\n    cliente_nome: cliente.nome,\n    cliente_telefone: cliente.telefone,\n    cliente_endereco: cliente.endereco,\n    valor_total: pedido.valor_total,\n    resumo_itens: resumoItens,\n    notificacao_texto: `📢 *Novo Orçamento Criado no SmartLar*\\n\\n👤 *Cliente:* ${cliente.nome}\\n📞 *Telefone:* ${cliente.telefone}\\n📍 *Endereço:* ${cliente.endereco}\\n💰 *Total:* R$ ${Number(pedido.valor_total).toFixed(2)}\\n\\n📦 *Itens:*\\n${resumoItens}`\n  }\n}];"
      },
      "name": "Formatar Dados e Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300],
      "id": "code-format-message"
    }
  ],
  "connections": {
    "Webhook Supabase (Insert Pedido)": {
      "main": [
        [
          {
            "node": "Buscar Pedido Completo (Supabase)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Pedido Completo (Supabase)": {
      "main": [
        [
          {
            "node": "Formatar Dados e Mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
